# ============================================================================
# CTMon 2.2.0 - secrets file template
#
# How to use:
#   1. copy this file to ".env" NEXT TO CTMon.ps1  (or to ~/.config/ctmon/.env)
#   2. fill in your values below
#   3. run:  ./CTMon.ps1 -TestAlert     -> verifies delivery
#
# Resolution order (first hit wins):
#   process environment  >  .env next to CTMon.ps1  >  ~/.config/ctmon/.env  >  config.json
#
# TIP: or just run  ./CTMon.ps1 -Setup  and the wizard writes this file for you.
# ============================================================================

# Telegram bot token from @BotFather (e.g. 123456789:AAE_xxxxxxxxxxxxxxxxxxxx)
TELEGRAM_BOT_TOKEN=

# Numeric chat id (send /start to your bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read "chat":{"id":...})
TELEGRAM_CHAT_ID=

# Optional: Discord webhook url - used when notify = "discord"
#   (server settings -> integrations -> webhooks -> new webhook -> copy url)
DISCORD_WEBHOOK_URL=

# Optional: generic JSON webhook url - used when notify = "webhook"
#   (works with Slack-compatible bridges, n8n, ntfy, custom listeners)
GENERIC_WEBHOOK_URL=

# Optional: Slack incoming webhook url - used when notify = "slack"
#   (slack app api.slack.com/apps -> incoming webhooks -> add to workspace -> copy url)
SLACK_WEBHOOK_URL=

# Optional: ntfy push channel - used when notify = "ntfy"
#   1. install ntfy / open https://ntfy.sh app
#   2. subscribe to a hard-to-guess topic (e.g. ctmon-x7k2p9-alerts)
#   3. put the topic below; NTFY_TOKEN only for protected/self-hosted servers
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# Optional: certspotter.com api token (the bypass failover source)
#   free tier works WITHOUT a token; a token raises the rate limit
CERTSPOTTER_TOKEN=

# Optional: proxy used for crt.sh / certspotter / DoH requests when the VPN is
#   off or CT sites are blocked. Supported: http:// https:// socks5://
#   Examples:
#     HTTPS_PROXY=socks5://127.0.0.1:9050        (Tor)
#     HTTPS_PROXY=http://127.0.0.1:8080
#   unset = direct connection (config net_proxy also works; env wins)
HTTPS_PROXY=

# Optional: dashboard server port (same as -Port; default 8080)
DASHBOARD_PORT=8080
